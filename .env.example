# spisordning environment. Copy to .env and fill in — .env is gitignored.

# PostgreSQL (docker-compose)
POSTGRES_PASSWORD=change-me

# Willys credentials for the willys-adapter (same as willys-client's .env).
# NOTE: docker-compose uses ${VAR:?...} — values must be non-empty or compose
# refuses to interpolate, so keep a placeholder here, not an empty string.
WILLYS_USERNAME=YYYYMMDDXXXX
WILLYS_PASSWORD=change-me

# Homelab integrations (used as the slice grows)
MEALIE_BASE_URL=http://hlab-mealie:9000
MEALIE_API_TOKEN=
OLLA_OPENAI_BASE_URL=http://192.168.1.240:40114/olla/openai/v1
SKOLMATEN_BASE_URL=http://192.168.1.120:8787
