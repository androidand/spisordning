# Multi-stage build for the mcp-server binary.
#
# Build:  docker build -t spisordning/mcp-server -f Dockerfile.mcp .
FROM golang:1.26-alpine AS build
RUN apk add --no-cache ca-certificates git
WORKDIR /src
ENV GOFLAGS=-mod=mod
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" ./cmd/mcp-server

FROM gcr.io/distroless/static-debian12
COPY --from=build /src/mcp-server /usr/local/bin/mcp-server
ENTRYPOINT ["mcp-server"]
CMD []
